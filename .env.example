# Used by `docker-compose.yml` (docker compose reads a `.env` file in this same
# directory automatically). Not used by the local `pnpm dev` workflow, which reads
# each subproject's own `.env` instead (api/.env, sync-server/.env).

JWT_SECRET="replace-with-a-long-random-string"
INTERNAL_SECRET="replace-with-a-long-random-string"

# Public origin the whole stack is reached at (Nginx). Only matters if you're not
# using the http://localhost default — e.g. a real domain.
WEB_ORIGIN="http://localhost"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_SYNC_SERVER_URL="ws://localhost/sync"
